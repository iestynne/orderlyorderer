# Second line of defence. The real guarantee is that the game archive lives in
# ../local/, outside this repository. See docs/DECISIONS.md D14d.
game/
assets/game/
*.love
v0.*-*.zip
node_modules/
dist/

# SPEC-007 §6.1: the asset build output. Game art, never publishable (D14b).
build/

# SPEC-009 §2: the harness browser. iestyn installs it; it is never committed.
.browsers/

# Tower JSON is derived from the game archive, so it is built, not committed
# (tools/paths.ts). `npm run parse-towers` writes it into build/.
data/towers/
